+		METHOD: "POST", ACTION: action, RULE: rule,
+		CREATE_TIME: "2026-10-14 10:00:00", UNIX_ADD_TIME: 1760407200000, Day: 20261014,
+		HEADER: "User-Agent: curl", BODY: "a=1", RES_BODY: "ok",
+	}

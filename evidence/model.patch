+// 正常路径：事件三层齐全、正常请求窄行进，全部确认后台账清空、副作用各一次。
+func TestLogLedgerHappyPath(t *testing.T) {
+	logDB := openTestGorm(t, "log.db")
+	if err := logDB.AutoMigrate(&model.AccessLog{}, &model.SecurityEvent{}, &model.EventPayload{}); err != nil {
+		t.Fatal(err)

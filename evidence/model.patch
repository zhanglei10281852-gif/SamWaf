+// 报文层失败：事件/窄行先行确认，副作用不触发；补建报文表后重试，
+// 只补报文层，事件与窄行不复制，副作用恰好一次。
+func TestLogLedgerPartialLayerResume(t *testing.T) {
+	logDB := openTestGorm(t, "log.db")

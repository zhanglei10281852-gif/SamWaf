diff --git a/cmd/samwaf/main.go b/cmd/samwaf/main.go
index 16002e0..fa42e0f 100644
--- a/cmd/samwaf/main.go
+++ b/cmd/samwaf/main.go
@@ -1009,8 +1009,14 @@ func (m *wafSystenService) stopSamWaf() {
 	zlog.Info("Shutdown SamWaf Queue Processors...")
 	// 关闭信号通道，通知所有队列处理协程退出
 	close(global.GWAF_QUEUE_SHUTDOWN_SIGNAL)
-	// 等待一段时间，让队列处理协程有时间完成当前工作并退出
-	time.Sleep(500 * time.Millisecond)
+	// 日志消费协程先停生产（上方引擎已关闭）再排空并等待已接收批次确认收敛；
+	// 超时未确认的批次留在本地台账，下次启动继续。其余队列协程随后给一点收尾时间。
+	if wafqueue.WaitLogQueueDrain() {
+		zlog.Info("Shutdown SamWaf Log Queue drain finished")
+	} else {
+		zlog.Warn("Shutdown SamWaf Log Queue drain timeout, unacknowledged batches will resume on next start")
+	}
+	time.Sleep(200 * time.Millisecond)
 	zlog.Info("Shutdown SamWaf Queue Processors finished")
 
 	// 设置任务停止标志
diff --git a/evidence/rubric-comparison.txt b/evidence/rubric-comparison.txt
new file mode 100644
index 0000000..de5b2f9
--- /dev/null
+++ b/evidence/rubric-comparison.txt
@@ -0,0 +1,9 @@
+项目：samwafgo-samwaf-a5225c20-6ca7-437b-90ed-f37c271eb401｜SamWaf 日志可恢复确认流程｜基线：49726fe7ed5176200ddde9726c94b46003d5eff3
+Rubric ID：1｜状态：通过｜期望行为：需要持久化的批次只有在安全事件、访问日志和应有报文层全部成功后才被确认释放，正常写入后的日志可按既有查询路径完整读取。｜实际观察：processRow 逐层写入并仅在全部 NeedMask 层成功、完成位落盘和副作用调用返回后删除台账行；日志查询服务的 UUID、分区、过滤和详情用例全部通过。｜直接证据：wafqueue/log_ledger.go:331-403；go test -count=1 ./wafqueue 通过；go test -count=1 ./service/waf_service -run TestLog 通过
+Rubric ID：2｜状态：通过｜期望行为：日志数据库发生可恢复写入失败时，未确认日志不会从系统所有权中消失，并在数据库恢复后受控重试成功且不产生忙循环。｜实际观察：报文表缺失时批次保留 pending 且 attempts 增为 1，due_at 推迟；到期前再次处理 attempts 保持 1，补建表后 drain 重试成功并清除 pending。｜直接证据：wafqueue/log_ledger.go:311-329、425-457；TestLogLedgerBackoffDueRespected 与 TestLogQueueDrainRecovers 通过
+Rubric ID：3｜状态：通过｜期望行为：三层持久化部分成功时，恢复只补齐同一请求标识下缺失的层，已成功的行不重复且最终不会留下永久分裂的日志记录。｜实际观察：事件层和访问层先成功、报文层失败时 LayerMask 记录为 3；补建报文表后只写缺失报文层，最终 event/access/payload 行数为 1/2/1，已成功层未增加。｜直接证据：wafqueue/log_ledger.go:340-372；TestLogLedgerPartialLayerResume 在 -race -count=3 下三次通过
+Rubric ID：4｜状态：未通过｜期望行为：有序关闭会先停止新的日志生产并排空已接收批次，关闭完成前日志已确认持久化，持续失败会留下可观察结果而非固定等待后静默丢失。｜实际观察：drainLogQueueOnShutdown 返回后，Queue.Enqueue 仍接受新日志且队列长度为 1；管理端在队列排空之后才关闭，登录接口仍直接调用 GQEQUE_LOG_DB.Enqueue。｜直接证据：受控 TestReviewerEnqueueAfterDrainRemainsUnconsumed 三次通过并观测 queue=1；cmd/samwaf/main.go:1009-1042；api/waf_login.go:220-236｜原因：关闭排空返回后所有生产入口仍可直接向运行队列入队且该条目无人消费｜影响：关闭窗口内新接收的日志只留在内存队列，进程退出后该日志消失｜证据位置：common/queue/queue.go:18-23；wafqueue/log_queue.go:143-180；cmd/samwaf/main.go:1009-1042
+Rubric ID：5｜状态：未通过｜期望行为：进程在批次持久化前后意外退出时，下一次启动会继续处理未确认工作而不重放已完成日志，恢复完成后可继续接收新日志。｜实际观察：dequeueRuntimeBatch 先从运行队列删除日志，runLogQueueOnce 随后才调用 ledger.admit；在两步之间中断后运行队列长度为 0，新台账 pending 为 0。｜直接证据：受控 TestReviewerDequeueBeforeAdmissionLosesOwnership 在 -race -count=3 下三次通过并观测 queue=0、pending=0；wafqueue/log_queue.go:112-140、183-205｜原因：dequeueRuntimeBatch 在台账 admit 前从运行队列删除日志，二者之间中断后队列和台账都没有该批次｜影响：该中断窗口内已被防护引擎接收的日志在重启后没有恢复来源｜证据位置：wafqueue/log_queue.go:112-140、183-205；wafqueue/log_ledger.go:250-309
+Rubric ID：6｜状态：通过｜期望行为：数据库重试、关闭排空和重启恢复不会重复增加 IP 失败计数、流量或分析统计，也不会重复投递 Kafka 与文件日志出口。｜实际观察：副作用完成位在重放前持久化，重启管理器按 EffectMask 跳过已完成项；部分层恢复和跨重启测试中五类副作用总调用数保持 5，重复 processDue 后不增加。｜直接证据：wafqueue/log_ledger.go:375-423；TestLogLedgerResumeAcrossRestart、TestLogLedgerCrashAfterEffectsReplaysNothing 与 TestLogLedgerPartialLayerResume 通过
+Rubric ID：7｜状态：未通过｜期望行为：日志持久化关闭时保持现有非落库行为，负样本蓄水池仍按原采样语义运行，正常批处理吞吐、SQLite、MySQL、PostgreSQL 和日志查询不回归。｜实际观察：关闭持久化、蓄水池、SQLite、查询路径和 go build 验证通过；MySQL 与 PostgreSQL 子用例连接 127.0.0.1 被拒后标记 SKIP，且本次未执行批量吞吐基准。｜直接证据：TestLogQueueEndToEndPersistDisabled、TestSampleReservoirCap、TestStoreTieredCrossEngine/sqlite 和 TestLogLookupUUIDIgnoresSelectedShardAndDate 通过；crossdb 输出记录 MySQL/PostgreSQL SKIP｜原因：MySQL 与 PostgreSQL 跨库用例因本机端口拒绝连接而跳过，正常批处理吞吐未执行基准验证｜影响：该条要求的两个真实后端与吞吐量没有通过本次可复现验证门槛｜证据位置：wafqueue/log_split_db_test.go:52-111；wafqueue/log_tier_db_test.go:30-40；crossdb 测试输出
+验证摘要：go build ./... 通过；go test -count=1 ./wafqueue 通过；日志查询定向测试通过；受控失败交错在 -race -count=3 下稳定复现；go test -count=1 ./... 的失败来自缺失测试数据、外部服务和既有测试签名失配，日志相关包通过。

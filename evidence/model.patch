+		t.Fatalf("死信行应保留: %v", err)
+	}
+	if dead.LastError == "" || len(dead.Payload) == 0 {
+		t.Fatal("死信必须保留最后错误与批次原文")
+	}
+	// 诊断可观察
+	items := m.diagCollect()
+	if items["dead"] != 1 || items["pending"] != 0 {
+		t.Fatalf("诊断计数不对: %v", items)
+	}
+	// 死信不再被处理
+	m.processDue(true)
+	if spy.totalCalls() != 0 {
+		t.Fatal("死信不得再被自动重试")
+	}
+}
